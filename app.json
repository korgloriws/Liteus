{
  "expo": {
    "name": "Liteus",
    "slug": "liteus",
    "version": "1.2.8",
    "orientation": "portrait",
    "icon": "./assets/iconLiteus.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "liteus",
    "splash": {
      "image": "./assets/logo_vertical_amarelo.png",
      "resizeMode": "contain",
      "backgroundColor": "#2f4366"
    },
    "ios": {
      "supportsTablet": true,
      "userInterfaceStyle": "light"
    },
    "android": {
      "package": "com.liteus.app",
      "versionCode": 18,
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/iconeLiteus.png",
        "backgroundColor": "#2f4366"
      },
      "icon": "./assets/iconeLiteus.png",
      "edgeToEdgeEnabled": true,
      "roundIcon": "./assets/iconeLiteus.png",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "expo-web-browser",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Lists",
              "label": "Liteus Listas",
              "description": "Resumo das listas e atalho para criar nova",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Notes",
              "label": "Liteus Notas",
              "description": "Resumo das notas e atalho para criar nova",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/withCleartextTraffic.js"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "009fa374-f223-4b85-83e1-d939f81ad687"
      }
    },
    "owner": "mateusalgusto"
  }
}
