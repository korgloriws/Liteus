{
  "expo": {
    "name": "Liteus",
    "slug": "liteus",
    "version": "1.0.9",
    "orientation": "portrait",
    "icon": "./assets/iconLiteus.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "liteus",
    "splash": {
      "image": "./assets/logo_vertical_amarelo.png",
      "resizeMode": "contain",
      "backgroundColor": "#2f4366"
    },
    "ios": {
      "supportsTablet": true,
      "userInterfaceStyle": "light"
    },
    "android": {
      "package": "com.liteus.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/iconeLiteus.png",
        "backgroundColor": "#2f4366"
      },
      "icon": "./assets/iconeLiteus.png",
      "edgeToEdgeEnabled": true,
      "roundIcon": "./assets/iconeLiteus.png",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.230416682609-joc8eira2ncs9ust2t7dop7igroigda8"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "009fa374-f223-4b85-83e1-d939f81ad687"
      },
      "googleWebClientId": "230416682609-h3fu0chs6sjjlmvgbeem8sulj29ro5tp.apps.googleusercontent.com",
      "googleAndroidClientId": "230416682609-joc8eira2ncs9ust2t7dop7igroigda8.apps.googleusercontent.com",
      "googleIosClientId": ""
    },
    "owner": "mateusalgusto"
  }
}
